# Nginx configuration for Right Care Finder API
# Place this file in /etc/nginx/sites-available/right-care-finder-api
# Then create a symlink: sudo ln -s /etc/nginx/sites-available/right-care-finder-api /etc/nginx/sites-enabled/

upstream nestjs_backend {
    server localhost:4001;
    keepalive 64;
}

server {
    listen 80;
    server_name api.yourdomain.com;  # Update with your domain

    # Redirect HTTP to HTTPS (uncomment after setting up SSL)
    # return 301 https://$server_name$request_uri;

    # For now, proxy to backend
    location / {
        proxy_pass http://nestjs_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Health check endpoint
    location /health {
        proxy_pass http://nestjs_backend;
        access_log off;
    }

    # Swagger documentation
    location /api {
        proxy_pass http://nestjs_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

